{
  "version": "2.2.3",
  "name": "herald-ai",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "dotenv-flow": "^4.1.0",
    "esbuild": "^0.25.0",
    "marked": "^18.0.2",
    "picocolors": "^1.1.1",
    "zod": "^4.1.8"
  },
  "scripts": {
    "build": "NODE_ENV=production tsup",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "files": [
    "dist"
  ],
  "bin": {
    "herald-ai": "./dist/index.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/define-config.d.ts",
      "import": "./dist/define-config.js",
      "require": "./dist/define-config.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/amirhosseinNouri/herald-ai"
  }
}
